# database.default.port = 3306

# database.tests.* — the connection the test suite uses (CI_ENVIRONMENT=testing).
# It MUST be a throwaway database whose name ends in "_test": the feature tests
# DELETE FROM every application table in setUp(), and Tests\Support\DatabaseTestCase
# refuses to run against any other name. Create it once next to the working
# database and migrate it with `php spark migrate -g tests` — see README.md, "Tests".
database.tests.hostname = 127.0.0.1
database.tests.database = db_test
database.tests.username = user
database.tests.password = password
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.port = 3306

